# iOS simulator -> your Laravel API
EXPO_PUBLIC_API_URL_IOS=http://paydayplanners.test

# Android emulator -> your Laravel API
EXPO_PUBLIC_API_URL_ANDROID=http://paydayplanners.test

# Public legal pages host
EXPO_PUBLIC_LEGAL_URL=http://paydayplanners.test

# Optional explicit legal document URLs
EXPO_PUBLIC_TERMS_URL=http://paydayplanners.test/terms
EXPO_PUBLIC_PRIVACY_URL=http://paydayplanners.test/privacy

# Optional local Sentry toggles
EXPO_PUBLIC_SENTRY_DSN=
EXPO_PUBLIC_SENTRY_ENABLE_DEV=false
