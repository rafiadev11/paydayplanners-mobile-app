{
  "expo": {
    "owner": "powermyfitness",
    "name": "Payday Planner",
    "slug": "paydayplanners",
    "scheme": "paydayplanners",
    "version": "1.1.5",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F4EFE7"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.paydayplanners.app",
      "infoPlist": {
        "NSFaceIDUsageDescription": "Allow PaydayPlanner to use Face ID to protect your paycheck and billing details.",
        "ITSAppUsesNonExemptEncryption": false,
        "NSAppTransportSecurity": {
          "NSExceptionDomains": {
            "paydayplanners.test": {
              "NSExceptionAllowsInsecureHTTPLoads": true,
              "NSIncludesSubdomains": true
            }
          }
        }
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.paydayplanners.app"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "extraProguardRules": "-keep @interface expo.modules.kotlin.records.** { *; }\n-keep class expo.modules.notifications.** implements java.io.Serializable { *; }"
          }
        }
      ],
      "expo-router",
      "expo-secure-store",
      "@react-native-community/datetimepicker",
      "expo-web-browser",
      "expo-notifications",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "backgroundColor": "#F4EFE7",
          "resizeMode": "contain",
          "imageWidth": 200
        }
      ],
      [
        "@sentry/react-native/expo",
        {
          "url": "https://sentry.io/",
          "project": "payday-planner-mobile",
          "organization": "power-my-fitness"
        }
      ],
      "expo-font",
      "@sentry/react-native",
      "./plugins/with-android-optimization.cjs",
      "./plugins/with-payday-watch.cjs"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "befcd00c-a29b-4428-8343-60ad39794d33"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/befcd00c-a29b-4428-8343-60ad39794d33"
    }
  }
}
